+/* Caller holds the policy lock and the controller is frozen. RX slots are
+ * reconfigured as one complete set; MB0 and the final TX mailbox are untouched.
+ */
+int flexcan_omam_program(struct net_device *dev,
+			 const struct omam_flexcan_request *policy)
+{
+	struct flexcan_priv *priv = netdev_priv(dev);
+	struct flexcan_omam *s = &priv->omam;
+	struct flexcan_regs __iomem *regs = priv->regs;
+	struct omam_flexcan_program program;
+	unsigned int slot, n;
+	u64 rx_mask = 0;
+	int err;
+
+	err = omam_flexcan_compile(policy, s->capacity, &program);
+	if (err)
+		return err;
+	if (!(priv->read(&regs->mcr) & FLEXCAN_MCR_FRZ_ACK))
+		return -EBUSY;
+	s->readback = false;
+	s->applied_mode = OMAM_FLEXCAN_UNAVAILABLE;
+	for (slot = 0; slot < s->capacity; slot++) {
+		struct flexcan_mb __iomem *mb;
+
+		n = priv->offload.mb_first + slot;
+		mb = flexcan_get_mb(priv, n);
+		priv->write(FLEXCAN_MB_CODE_RX_INACTIVE, &mb->can_ctrl);
+		priv->write(program.mask[slot], &regs->rximr[n]);
+		priv->write(program.id[slot], &mb->can_id);
+		priv->write(program.control[slot], &mb->can_ctrl);
+		if (priv->read(&regs->rximr[n]) != program.mask[slot] ||
+		    priv->read(&mb->can_id) != program.id[slot] ||
+		    (priv->read(&mb->can_ctrl) & (FLEXCAN_MB_CODE_MASK |
+			FLEXCAN_MB_CNT_IDE | FLEXCAN_MB_CNT_RTR)) != program.control[slot])
+			return -EIO;
+		if (program.control[slot])
+			rx_mask |= FLEXCAN_IFLAG_MB(n);
+	}
+	flexcan_write64(priv, GENMASK_ULL(priv->offload.mb_last,
+					  priv->offload.mb_first), &regs->iflag1);
+	priv->rx_mask = rx_mask;
+	s->readback = true;
+	s->applied_mode = le32_to_cpu(policy->mode);
+	atomic_set(&s->rx_fault, 0);
+	return 0;
+}
+
+static void flexcan_omam_sync_irqs(struct net_device *dev)
+{
+	struct flexcan_priv *priv = netdev_priv(dev);
+
+	synchronize_irq(dev->irq);
+	if (priv->devtype_data.quirks & FLEXCAN_QUIRK_NR_IRQ_3) {
+		synchronize_irq(priv->irq_boff);
+		synchronize_irq(priv->irq_err);
+	}
+	if (priv->devtype_data.quirks & FLEXCAN_QUIRK_SECONDARY_MB_IRQ)
+		synchronize_irq(priv->irq_secondary_mb);
+}
+
+void flexcan_omam_unavailable(struct net_device *dev)
+{
+	struct flexcan_priv *priv = netdev_priv(dev);
+	struct flexcan_omam *s = &priv->omam;
+
+	s->readback = false;
+	s->applied_mode = OMAM_FLEXCAN_UNAVAILABLE;
+	if (netif_running(dev) && !s->suspended) {
+		netif_tx_disable(dev);
+		flexcan_chip_interrupts_disable(dev);
+		flexcan_omam_sync_irqs(dev);
+		flexcan_chip_disable(priv);
+		can_flush_echo_skb(dev);
+		netif_carrier_off(dev);
+		priv->can.state = CAN_STATE_STOPPED;
+	}
+}
+
+static int flexcan_omam_freeze_io(void *context)
+{
+	return flexcan_chip_freeze(netdev_priv((struct net_device *)context));
+}
+
+static int flexcan_omam_program_io(void *context, const struct omam_flexcan_request *policy)
+{
+	return flexcan_omam_program(context, policy);
+}
+
+static int flexcan_omam_unfreeze_io(void *context)
+{
+	return flexcan_chip_unfreeze(netdev_priv((struct net_device *)context));
+}
+
+static const struct omam_flexcan_io flexcan_omam_io = {
+	.freeze = flexcan_omam_freeze_io,
+	.program = flexcan_omam_program_io,
+	.unfreeze = flexcan_omam_unfreeze_io,
+};
+
+int flexcan_omam_apply(struct net_device *dev,
+		       const struct omam_flexcan_request *policy)
+{
+	struct flexcan_priv *priv = netdev_priv(dev);
+	struct flexcan_omam *s = &priv->omam;
+	int err;
+
+	if (s->suspended)
+		return -EBUSY;
+	if (!netif_running(dev)) {
+		s->readback = false;
+		s->applied_mode = OMAM_FLEXCAN_UNAVAILABLE;
+		s->recovery = OMAM_FLEXCAN_RECOVERY_NONE;
+		s->last_error = 0;
+		return 0; /* Commit the desired policy; open reapplies before readiness. */
+	}
+	if (priv->can.state >= CAN_STATE_BUS_OFF)
+		return -EBUSY;
+
+	netif_tx_disable(dev);
+	flexcan_chip_interrupts_disable(dev);
+	flexcan_omam_sync_irqs(dev);
+	/* An in-flight TX IRQ may have woken the queue during synchronization. */
+	netif_tx_disable(dev);
+	if (priv->can.state >= CAN_STATE_BUS_OFF || priv->can.echo_skb[0] ||
+	    (priv->read(&priv->tx_mb->can_ctrl) & FLEXCAN_MB_CODE_MASK) !=
+	    FLEXCAN_MB_CODE_TX_INACTIVE) {
+		flexcan_chip_interrupts_enable(dev);
+		if (!priv->can.echo_skb[0] && priv->can.state < CAN_STATE_BUS_OFF)
+			netif_wake_queue(dev);
+		return -EBUSY; /* Never abort a pending command to replace an RX policy. */
+	}
+	can_rx_offload_disable(&priv->offload);
+	s->gaps++;
+	/* All IRQ and NAPI writers are quiescent. Queued old-generation frames may
+	 * not leak through after the response. The gap counter records this loss.
+	 */
+	skb_queue_purge(&priv->offload.skb_queue);
+	__skb_queue_purge(&priv->offload.skb_irq_queue);
+	err = omam_flexcan_transition(&flexcan_omam_io, dev, policy, &s->policy, &s->recovery);
+	s->last_error = err;
+	if (s->recovery == OMAM_FLEXCAN_RECOVERY_ACCEPT_ALL) {
+		memset(&s->policy, 0, sizeof(s->policy));
+		s->identity.policy_generation++;
+	}
+	if (s->recovery == OMAM_FLEXCAN_RECOVERY_UNAVAILABLE) {
+		flexcan_omam_unavailable(dev);
+		can_rx_offload_enable(&priv->offload);
+		return err;
+	}
+	can_rx_offload_enable(&priv->offload);
+	flexcan_chip_interrupts_enable(dev);
+	if (priv->can.state < CAN_STATE_BUS_OFF)
+		netif_wake_queue(dev);
+	return err;
+}
