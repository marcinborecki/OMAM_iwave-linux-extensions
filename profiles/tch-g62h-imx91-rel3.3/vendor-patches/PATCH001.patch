+
+/ {
+	gpio-keys {
+                compatible = "gpio-keys";
+                pinctrl-names = "default";
+                pinctrl-0 = <&pinctrl_gpio_keys>;
+
+                power {
+                        label = "wakeup-gpio";
+                        gpios = <&gpio3 25 0>;
+                        keep-power-in-suspend;
+                        gpio-key,wakeup;
+                        wakeup-source;
+                        linux,code = <29>;
+                };
+        };
+};
+&iomuxc {
+
+	pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_expansion>;
+
+
+	pinctrl_gpio_keys: gpio_keysgrp {
+                fsl,pins = <
+                        MX91_PAD_SD3_DATA3__GPIO3_IO25           0x51d
+                >;
+        };
+
+	
+	pinctrl_expansion: expansion_pinsgrp {
+                fsl,pins = <
+                        MX91_PAD_SAI1_TXC__GPIO1_IO12                   0x51d
+                        MX91_PAD_CCM_CLKO3__GPIO4_IO28                  0x51d /*cellular PWR KEY */
+                        MX91_PAD_GPIO_IO18__GPIO2_IO18                  0x518 /*DOUT2 */
+                        MX91_PAD_GPIO_IO19__GPIO2_IO19                  0x518 /*cellular switch */
+                        MX91_PAD_ENET1_RD0__GPIO4_IO10                  0x51d /*Assm conf bit 4 */
+                        MX91_PAD_ENET2_RD2__GPIO4_IO26                  0x57d /*cellular USB boot */
+                        /*MX91_PAD_GPIO_IO20__GPIO2_IO20                  0x518*/ /* BR mode enable */
+                        MX91_PAD_GPIO_IO10__GPIO2_IO10                  0x518 /* STATUS LED */
+                        MX91_PAD_GPIO_IO11__GPIO2_IO11                  0x518  /*WIR*/ 
+                        MX91_PAD_GPIO_IO04__GPIO2_IO4                   0x318  /*secure ele */
+                        MX91_PAD_GPIO_IO06__GPIO2_IO6                   0xb98  /*BR enable */
+                        MX91_PAD_GPIO_IO07__GPIO2_IO7                   0xb98  /*3v3 LD0 enable */
+                        MX91_PAD_GPIO_IO08__GPIO2_IO8                   0xb98  /*1v8 LD0 enable */      
+                        MX91_PAD_GPIO_IO00__GPIO2_IO0                   0x518  /*BAT charger CE pin*/
+                        MX91_PAD_SD3_CMD__GPIO3_IO21                    0x51d  /*Load dump */
+                        MX91_PAD_CCM_CLKO4__GPIO4_IO29                  0x57d /*cellular mod emergency off */
+                        MX91_PAD_SD3_DATA1__GPIO3_IO23                  0x51d /*BLE reset */
+                        MX91_PAD_SD3_DATA2__GPIO3_IO24                  0x51d /*Load dump */
+                        MX91_PAD_SD2_CMD__GPIO3_IO2                     0x51d /*cellular status */
+                        MX91_PAD_SD2_CLK__GPIO3_IO1                     0x51d /*Bat charger PG pin */
+                        MX91_PAD_SD2_DATA3__GPIO3_IO6                   0x51d /*Bat charger status */   
+                        MX91_PAD_ENET1_TD0__GPIO4_IO5                   0x51d /*cellular main DTR */ 
+                        MX91_PAD_ENET1_TD1__GPIO4_IO4                   0x51d /*cellular  main DCD */
+                        MX91_PAD_ENET1_TD3__GPIO4_IO2                   0x51d /*cellular reset */
+                        MX91_PAD_ENET1_TX_CTL__GPIO4_IO6                0x51d /*BLE host wake up */
+                        MX91_PAD_ENET1_TXC__GPIO4_IO7                   0x51d /*BLE reset */
+                        MX91_PAD_ENET1_RD1__GPIO4_IO11                  0x51d /*Assm conf bit 5 */      
+                        MX91_PAD_ENET1_RD2__GPIO4_IO12                  0x51d /* BLE FOTA pin 1 */
+                        MX91_PAD_ENET1_RD3__GPIO4_IO13                  0x51d /* BLE FOTA pin 2 */
+                        MX91_PAD_ENET1_RX_CTL__GPIO4_IO8                0x51d /*Assm conf bit 3 */
+                        MX91_PAD_ENET1_RXC__GPIO4_IO9                   0x51d /*Assm conf bit 2 */
+                        MX91_PAD_ENET1_MDIO__GPIO4_IO1                  0x51d /*Assm conf bit 1 */
+                        MX91_PAD_ENET1_MDC__GPIO4_IO0                   0x51d /*Assm conf bit 0 */
+                        MX91_PAD_ENET2_TD2__GPIO4_IO17                  0x51d  /*secure ele 1*/
+                        MX91_PAD_ENET2_TD3__GPIO4_IO16                  0x51d /*secure ele 2*/  
+                        MX91_PAD_ENET2_TX_CTL__GPIO4_IO20               0x51d /*DOUT */
+                        MX91_PAD_ENET2_TXC__GPIO4_IO21                  0x51d   /*DIN */
+                        MX91_PAD_ENET2_RD3__GPIO4_IO27                  0x51d /*BLE additional GPIO1 */
+                        MX91_PAD_ENET2_RX_CTL__GPIO4_IO22               0x51d /*BLE additional GPIO2 */ 
