diff -Naur A/drivers/power/supply/bq256xx_charger.c B/drivers/power/supply/bq256xx_charger.c
--- A/drivers/power/supply/bq256xx_charger.c	2026-04-20 18:21:03.473200336 +0530
+++ B/drivers/power/supply/bq256xx_charger.c	2026-04-20 18:26:28.273049872 +0530
@@ -1765,7 +1765,23 @@
 		return ret;
 	}
 
-	return ret;
+	/* The below changes will reduce the Battery Charging Current to 300mA */
+	ret = regmap_write(bq->regmap, BQ256XX_CHARGE_CURRENT_LIMIT, 0x85);
+	if (ret)
+		dev_err(dev, "Failed to set charge current\n");
+
+	ret = regmap_write(bq->regmap, BQ256XX_PRECHG_AND_TERM_CURR_LIM, 0x11);
+	if (ret)
+		dev_err(dev, "Failed to set precharge current\n");
+
+	/* Debug readback */
+	{
+		unsigned int val;
+		if (!regmap_read(bq->regmap, BQ256XX_CHARGE_CURRENT_LIMIT, &val))
+			dev_info(dev, "Charge current register = 0x%x\n", val);
+	}
+
+	return 0;   // <-- IMPORTANT
 }
 
